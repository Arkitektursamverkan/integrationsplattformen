# Integration Platform – installation settings.
# Copy to .env and fill in. docker-compose.yml reads this file.

# ── Compose ───────────────────────────────────────────────────────────────────
# Add your own overlay for extra ports etc., e.g.
#   COMPOSE_FILE=docker-compose.yml:deploy/<org>/compose.<org>.yml
# COMPOSE_FILE=docker-compose.yml
# Running Arkitekturportalen on the same server? Put both on a shared network
# (once: docker network create arkitekturportalen) and add
# deploy/shared-network.yml, e.g.
#   COMPOSE_FILE=docker-compose.yml:deploy/shared-network.yml
# Host ports: the web UI (the API is under /api on the same port).
WEB_PORT=3100
# The API itself is not published on the host. For development (API docs at
# http://localhost:8100/api/docs) or a script on the same machine, add
# deploy/api-port.yml, e.g.
#   COMPOSE_FILE=docker-compose.yml:deploy/api-port.yml
API_PORT=8100

# ── Environment ───────────────────────────────────────────────────────────────
# production (default in compose) | development | test.
# Anything but development/test refuses to start if a secret below is empty,
# a placeholder or shorter than 32 characters.
APP_ENV=production
LOG_LEVEL=info

# ── Secrets ───────────────────────────────────────────────────────────────────
# Generate each with:  openssl rand -hex 32
# Encrypts stored connection credentials. Changing it later makes them
# unreadable – keep it with your backups.
ENCRYPTION_KEY=
# Admin key for scripts and for Arkitekturportalen's "Fetch now".
ADMIN_API_KEY=
# Signs login tokens for the web UI.
JWT_SECRET=
# Database password – required, compose refuses to start without it:
#   openssl rand -hex 16
# Only read when the database volume is first created; changing it later also
# needs ALTER USER in the database. In production the API refuses to start
# with a known default such as integration_pass.
POSTGRES_PASSWORD=

# ── Web ───────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3100
# Rate limits (e.g. 10 login attempts a minute) count per client address.
# Behind a proxy (the web's nginx, Render) every request has the proxy's
# address; true = take the client from X-Forwarded-For instead. Only set it
# when the API can be reached through that proxy alone – the header is
# otherwise whatever the caller sends. Note that deploy/api-port.yml publishes
# the API directly.
TRUST_PROXY_HEADERS=false
# Antal proxyer framför API:t som lägger till ett led i X-Forwarded-For.
# Klienten är ledet så många steg från höger (led längre till vänster kan
# anroparen ha hittat på). Webbens nginx ensam = 1.
TRUSTED_PROXY_COUNT=1
# Webbens nginx: proxyn framför den (lastbalanserare, Render), som adress
# eller intervall – flera med mellanslag eller komma, t.ex. 10.0.0.0/8. Då
# räknas klientens adress (ur proxyns X-Forwarded-For) i stället för proxyns.
# Tomt = nginx ser klienten direkt. nginx skickar alltid bara ett led vidare.
TRUSTED_PROXY=
# Inloggning: så många misslyckade försök per användarnamn inom fönstret
# (sekunder) spärrar namnet tillfälligt, utöver gränsen per adress.
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW_SECONDS=900

# ── Operations ────────────────────────────────────────────────────────────────
EXECUTION_LOG_RETENTION_DAYS=30
# Teams/Slack-style webhook for failed runs (see docs/teams-webhook-setup.md).
ALERT_WEBHOOK_URL=
# Signerar varje flödes webhook "efter körning" (X-Webhook-Timestamp +
# X-Webhook-Signature, HMAC-SHA256 över tidsstämpel och kropp); själva
# hemligheten skickas aldrig. Samma värde som SYNC_WEBHOOK_SECRET i
# Arkitekturportalen, som kräver en portal som kan verifiera signaturen.
POST_EXEC_WEBHOOK_SECRET=
# Inloggning med Microsoft – samma app-registrering som Arkitekturportalen och
# Arkitekten. Lägg till https://<plattformens adress>/login som SPA-omdirigering
# i registreringen. Tomt = bara egna konton. Scope tomt = api://<client>/access_as_user.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_API_SCOPE=
# Scopet en token måste ha för att godtas här. Tomt = sista delen av
# ENTRA_API_SCOPE (access_as_user, samma som portalen och Arkitekten – deras
# token godtas då även här). Se docs/sakerhet.md om ett eget scope.
ENTRA_REQUIRED_SCOPE=
# Blir administratörer vid första Microsoft-inloggningen – bara så länge
# plattformen saknar administratör. Andra måste först läggas till i
# plattformen med samma e-post (utan lösenord, se docs/sakerhet.md).
BOOTSTRAP_ADMIN_EMAILS=
# Render-automatik: Arkitekturportalens API, full adress
# (http://portal-api:8000/api/v1) eller bara värd:port. Satt = de Entra-fält
# ovan som är tomma hämtas ur portalen (GET /installation) vid starten och
# därefter var 5:e minut. Egna värden ovan vinner alltid. Tomt = inget hämtas.
PORTAL_URL=
# Portalens SYNC_WEBHOOK_SECRET (X-Installation-Secret). Tomt = POST_EXEC_WEBHOOK_SECRET.
PORTAL_INSTALLATION_SECRET=
# Engångskod för det första administratörskontot (sidan /setup). Krävs i
# produktion – annars blir den som först hittar en ny installation dess
# administratör. Skapa med:  openssl rand -hex 16
SETUP_CODE=
# Arkitektens flödestjänst, t.ex. http://arkitekten:8200 (värd utan port = 8200).
# Satt = källan som hämtar Arkitektens publicerade processbilder skapas vid
# starten, om ingen sådan källa finns. Tomt = skapa den själv i gränssnittet.
ARKITEKTEN_URL=
# Samma värde som Arkitektens ARK_FLODESTJANST_NYCKEL – skickas som
# X-Arkitekten-Nyckel till flödestjänsten. Tomt = ingen nyckel. Skickas BARA
# till ARKITEKTEN_URL (samma schema, värd och port) – en Arkitekten-koppling
# med en annan adress får ingen nyckel. Sätt alltså ARKITEKTEN_URL.
ARK_FLODESTJANST_NYCKEL=

# ── Kopplingarnas nätverk (SSRF-spärr) ────────────────────────────────────────
# Kopplingar (REST, 2C8, Arkitekten) får inte anropa interna adresser:
# loopback, länklokala (169.254.169.254), privata (10.x, 172.16–31.x,
# 192.168.x), delade och reserverade. auto = på utom när APP_ENV är
# development/test; true/false = alltid på/av.
CONNECTOR_BLOCK_INTERNAL=auto
# Interna mål som ändå ska nås, kommaseparerade: värdnamn (arkitekten,
# 2c8.intern.example), domäner (*.intern.example), adresser (10.1.2.3) eller
# nät (10.0.0.0/8). Värden i ARKITEKTEN_URL är alltid tillåten.
# VIKTIGT: når plattformen 2C8, REST-API:er eller annat på det interna nätet
# eller i samma docker-nät måste de stå här, annars stoppas hämtningarna.
CONNECTOR_ALLOWED_HOSTS=

# ── Local development only (npm run dev) ──────────────────────────────────────
VITE_API_BASE_URL=
