server {
    # PORT (default 80) is set by a platform such as Render.
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/security-headers.conf;

    # Behind a proxy: client addresses from TRUSTED_PROXY's X-Forwarded-For
    # (docker/19-trusted-proxy.envsh). Empty without TRUSTED_PROXY.
${REAL_IP_CONFIG}
    # Gzip
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy /api to the FastAPI backend. API_UPSTREAM (default api:8000) is
    # filled in when the container starts, so the platform can run next to
    # Arkitekturportalen in one compose project under another service name.
    #
    # The address is looked up again every 10 s, not once at start: on a
    # platform such as Render a redeployed API gets a new address, and nginx
    # would otherwise keep sending to the old one until it restarts. The
    # resolvers are the container's own (NGINX_ENTRYPOINT_LOCAL_RESOLVERS).
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    location /api {
        set $api_upstream http://${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Exactly one entry, the client as nginx sees it (after real_ip above).
        # Appending to the caller's header would let it choose the address the
        # API's rate limits count (TRUST_PROXY_HEADERS, TRUSTED_PROXY_COUNT=1).
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
    }

    # Cache static assets — use no-cache so browser revalidates on each visit
    location ~* \.(js|css)$ {
        add_header Cache-Control "no-cache";
        include /etc/nginx/security-headers.conf;
    }
    location ~* \.(png|svg|ico|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public";
        include /etc/nginx/security-headers.conf;
    }
}
